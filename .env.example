# Copy to .env for local overrides. .env is gitignored; production sets real env vars (e.g. Railway).
# With no overrides the server uses the localhost defaults below (matching docker-compose.yml).

# APP_ENV=production makes the DATABASE_* values required (fail-fast at boot instead of dev defaults).
APP_ENV=development

# HTTP
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
APP_VERSION=dev

# Database (matches docker-compose.yml)
DATABASE_URL=jdbc:postgresql://localhost:5432/app
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_MAX_POOL_SIZE=10

# Object storage — S3-compatible (MinIO via docker-compose locally; Railway Buckets / AWS S3 in prod).
# Like DATABASE_*, these are required when APP_ENV=production (fail-fast at boot). The localhost
# defaults below match docker-compose.yml, so `./gradlew :server:app:run` finds MinIO with no config.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blobs
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
