# Copy to .env for local overrides. .env is gitignored; production sets real env vars (e.g. Railway).
# With no overrides the server uses the localhost defaults below (matching docker-compose.yml).

# APP_ENV=production makes the DATABASE_* values required (fail-fast at boot instead of dev defaults).
APP_ENV=development

# HTTP
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
APP_VERSION=dev

# Database (matches docker-compose.yml)
DATABASE_URL=jdbc:postgresql://localhost:5432/app
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_MAX_POOL_SIZE=10

# Object storage — S3-compatible (MinIO via docker-compose locally; Railway Buckets / AWS S3 in prod).
# Like DATABASE_*, these are required when APP_ENV=production (fail-fast at boot). The localhost
# defaults below match docker-compose.yml, so `./gradlew :server:app:run` finds MinIO with no config.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blobs
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# App-layer DoS limits (ARCHITECTURE_SERVER.md §11).
# CLIENT_IP_HEADER: trusted proxy header carrying the real client IP for rate-limit keying.
# Leave unset when directly exposed (socket address is used). Running behind a load balancer?
# Set it to the header YOUR proxy guarantees (Railway: X-Real-IP; Cloudflare: CF-Connecting-IP) —
# an unset value behind a proxy puts all clients in one shared bucket (fails loud), while a wrong
# value lets clients forge fresh buckets (fails silent).
#CLIENT_IP_HEADER=X-Real-IP
CREDENTIAL_RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=1048576

# Root logback level for local runs. scripts/dev-stack.sh defaults it to DEBUG; unset means INFO
# (deployments too — the Docker image never reads this file). Framework loggers stay pinned at
# INFO in logback.xml, so DEBUG is about this app's code, not Netty/Hikari noise.
#LOG_LEVEL=DEBUG
