# Copy to .env for local overrides. .env is gitignored; production sets real env vars.
# These match docker-compose.yml. scripts/dev-stack.sh loads this file with .env on top; for a bare
# `./gradlew :server:app:run`, export first: set -a && . ./.env && set +a

# REQUIRED: the server refuses to boot without these, in every environment.
# DATABASE_URL takes postgres://user:password@host:port/db or jdbc:postgresql://host:port/db; a jdbc
# url can get its credentials from DATABASE_USER / DATABASE_PASSWORD instead.
DATABASE_URL=postgres://app:app@localhost:5432/app
# HS256 signing secret, at least 32 characters. This value is for local development only.
JWT_SECRET=dev-only-jwt-secret-0123456789abcdef

# Object storage, S3-compatible (RustFS via docker-compose locally). Read only if something injects
# BlobStore; then all five are required. docker-compose.yml reads the bucket and credentials too.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blobs
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key

# Optional, shown with their defaults.
#SERVER_HOST=0.0.0.0
#SERVER_PORT=8080
#METRICS_PORT=8081
#APP_VERSION=dev
#DATABASE_MAX_POOL_SIZE=10
#JWT_ISSUER=kmp-template
#JWT_AUDIENCE=kmp-template
#JWT_ACCESS_TTL_MINUTES=15

# App-layer DoS limits.
# CLIENT_IP_HEADER: trusted proxy header carrying the real client IP for rate-limit keying.
# Leave unset when directly exposed (socket address is used). Running behind a load balancer?
# Set it to the header YOUR proxy guarantees (Railway: X-Real-IP; Cloudflare: CF-Connecting-IP) —
# an unset value behind a proxy puts all clients in one shared bucket (fails loud), while a wrong
# value lets clients forge fresh buckets (fails silent).
#CLIENT_IP_HEADER=X-Real-IP
#CREDENTIAL_RATE_LIMIT_PER_MINUTE=10
#MAX_REQUEST_BODY_BYTES=1048576

# Root logback level for local runs. scripts/dev-stack.sh defaults it to DEBUG; unset means INFO
# (deployments too — the Docker image never reads this file). Framework loggers stay pinned at
# INFO in logback.xml, so DEBUG is about this app's code, not Netty/Hikari noise.
#LOG_LEVEL=DEBUG
