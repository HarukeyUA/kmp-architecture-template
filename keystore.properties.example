# Android release signing, local builds only.
#
# Copy to `keystore.properties` (gitignored) at the repo root and fill in real values to sign
# local `assemble*Release` builds. CI does not use this file; it passes the same values through
# the ANDROID_KEYSTORE_FILE / ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD
# environment variables instead.
#
# When neither this file nor the env vars are present, release builds still assemble, unsigned.

# Absolute path (recommended) to the keystore, or a path relative to the client/androidApp/ module.
storeFile=/absolute/path/to/release.jks
storePassword=changeme
keyAlias=release
keyPassword=changeme
