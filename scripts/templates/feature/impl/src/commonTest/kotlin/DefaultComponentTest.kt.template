package {{PACKAGE_PATH}}

import assertk.assertThat
import assertk.assertions.isEqualTo
import com.arkivanov.essenty.lifecycle.LifecycleRegistry
import kotlin.test.Test
import kotlinx.coroutines.test.runCurrent
import {{BASE_PACKAGE}}.core.testing.runLifecycleTest
import {{BASE_PACKAGE}}.core.testing.testComponentContext

class Default{{FEATURE_NAME}}ComponentTest {
    private val repository = Fake{{FEATURE_NAME}}Repository(initialCount = 2)

    @Test
    fun `the stored count shows`() = runLifecycleTest { lifecycle ->
        val component = component(lifecycle)
        runCurrent()

        assertThat(component.state.value.count).isEqualTo(2)
    }

    @Test
    fun `a click goes through the repository and back into the state`() =
        runLifecycleTest { lifecycle ->
            val component = component(lifecycle)
            runCurrent()

            component.state.value.eventSink({{FEATURE_NAME}}Component.Event.CountClicked)
            runCurrent()

            assertThat(component.state.value.count).isEqualTo(3)
        }

    private fun component(lifecycle: LifecycleRegistry): {{FEATURE_NAME}}Component =
        Default{{FEATURE_NAME}}Component(
                componentContext = testComponentContext(lifecycle = lifecycle),
                repository = repository,
            )
            .apply { state }
}
