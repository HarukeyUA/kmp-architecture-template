<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- reqId is the per-request correlation id put into the MDC by CallLogging. -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [reqId=%X{requestId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- LOG_LEVEL is a local-dev knob (scripts/dev-stack.sh exports DEBUG); deployments that
         don't set it get INFO. Framework loggers below stay pinned so DEBUG means *our* code. -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="io.netty" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
    <!-- Silences the orphaned LoggingMeterRegistry that Ktor's MicrometerMetrics config
         instantiates as its default before we swap in the Prometheus registry. -->
    <logger name="io.micrometer.core.instrument.push.PushMeterRegistry" level="WARN"/>
</configuration>
